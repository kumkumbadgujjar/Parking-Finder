def show_map(location=None, lat=None, lon=None):
    try:
        # If user entered location
        if location:
            geo = Nominatim(user_agent="parking_app")
            loc = geo.geocode(location)

            if not loc:
                messagebox.showerror("Error", "Location not found")
                return

            lat, lon = loc.latitude, loc.longitude

        if lat is None or lon is None:
            messagebox.showerror("Error", "Location not available")
            return

        m = folium.Map(location=[lat, lon], zoom_start=15)

        # 📍 User marker
        folium.Marker(
            [lat, lon],
            popup="📍 Your Location",
            icon=folium.Icon(color="red")
        ).add_to(m)

        # 🌐 Overpass API (SAFE)
        url = "https://overpass-api.de/api/interpreter"
        query = f"""
        [out:json];
        node["amenity"="parking"](around:1500,{lat},{lon});
        out;
        """

        try:
            res = requests.get(url, params={'data': query}, timeout=10)

            if res.status_code != 200:
                messagebox.showerror("Error", "Parking API failed")
                return

            data = res.json()

        except Exception as e:
            print("API ERROR:", e)
            messagebox.showerror("Error", "Unable to fetch parking data")
            return

        parkings = []

        for el in data.get('elements', []):
            p_lat = el.get('lat')
            p_lon = el.get('lon')
            name = el.get('tags', {}).get('name', 'Parking')

            dist = distance(lat, lon, p_lat, p_lon)
            slots = random.randint(5, 50)

            parkings.append({
                "name": name,
                "lat": p_lat,
                "lon": p_lon,
                "distance": dist,
                "slots": slots,
                "prediction": predict_slots()
            })

        parkings.sort(key=lambda x: (-x["slots"], x["distance"]))

        for p in parkings:
            folium.Marker(
                [p["lat"], p["lon"]],
                popup=f"{p['name']}\nSlots: {p['slots']}\n{p['prediction']}",
                icon=folium.Icon(color="green")
            ).add_to(m)

        m.save("map.html")
        webbrowser.open("map.html")

    except Exception as e:
        print("ERROR:", e)
        messagebox.showerror("Error", "Something went wrong")